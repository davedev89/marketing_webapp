generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  USER
  ADMIN
}

enum UserStatus {
  ACTIVE
  INVITED
  SUSPENDED
  DELETED
}

enum OrganizationStatus {
  ACTIVE
  INCOMPLETE
  PAST_DUE
  PAUSED
  DELETED
}

enum MembershipRole {
  OWNER
  MEMBER
}

enum SubscriptionStatus {
  INCOMPLETE
  TRIALING
  ACTIVE
  PAST_DUE
  CANCELED
  UNPAID
  PAUSED
}

enum PlanCode {
  STARTER
  GROWTH
  SCALE
}

enum ConnectedAccountProvider {
  GOOGLE_ADS
  WHATSAPP
  STRIPE
}

enum ConnectionStatus {
  PENDING
  ACTIVE
  REQUIRES_REAUTH
  DISCONNECTED
  FAILED
}

enum GoogleAdsSyncStatus {
  IDLE
  SYNCING
  SUCCESS
  PARTIAL
  FAILED
}

enum WhatsAppProvider {
  MOCK
  META_CLOUD
}

enum WhatsAppDeliveryStatus {
  PENDING
  SENT
  DELIVERED
  READ
  FAILED
}

enum ReportStatus {
  PENDING
  GENERATED
  SENT
  FAILED
  SKIPPED
}

enum ReportFormat {
  BRIEF
  STANDARD
}

enum ReportChannel {
  WHATSAPP
}

enum JobType {
  GOOGLE_ADS_SYNC
  GENERATE_DAILY_REPORT
  SEND_DAILY_REPORT
  REFRESH_CONNECTION
  RETRY_DELIVERY
}

enum JobStatus {
  PENDING
  RUNNING
  SUCCESS
  FAILED
  RETRYING
  CANCELED
}

enum ChatMessageRole {
  USER
  ASSISTANT
  SYSTEM
}

enum ChatMessageSource {
  WEB
  WHATSAPP
  JOB
}

enum AuditEventType {
  AUTH_LOGIN
  AUTH_REGISTER
  ONBOARDING_COMPLETED
  SUBSCRIPTION_UPDATED
  GOOGLE_ADS_CONNECTED
  GOOGLE_ADS_SYNCED
  REPORT_GENERATED
  REPORT_SENT
  CHAT_QUESTION
  ADMIN_ACTION
  ERROR
}

model User {
  id                    String                 @id @default(cuid())
  email                 String                 @unique
  emailVerified         DateTime?
  passwordHash          String?
  fullName              String?
  locale                String                 @default("es")
  timezone              String                 @default("America/Argentina/Buenos_Aires")
  status                UserStatus             @default(ACTIVE)
  role                  UserRole               @default(USER)
  onboardingCompletedAt DateTime?
  lastLoginAt           DateTime?
  deletedAt             DateTime?
  createdAt             DateTime               @default(now())
  updatedAt             DateTime               @updatedAt

  memberships           OrganizationMember[]
  sessions              Session[]
  accounts              AuthAccount[]
  chatConversations     ChatConversation[]
  auditLogs             AuditLog[]
  ownedOrganizations    Organization[]         @relation("OrganizationOwner")

  @@index([status])
  @@index([deletedAt])
}

model Organization {
  id                  String                 @id @default(cuid())
  name                String
  businessName        String?
  country             String?
  locale              String                 @default("es")
  timezone            String                 @default("America/Argentina/Buenos_Aires")
  defaultCurrency     String                 @default("USD")
  status              OrganizationStatus     @default(INCOMPLETE)
  onboardingStep      Int                    @default(0)
  ownerUserId         String?
  deletedAt           DateTime?
  createdAt           DateTime               @default(now())
  updatedAt           DateTime               @updatedAt

  ownerUser           User?                  @relation("OrganizationOwner", fields: [ownerUserId], references: [id], onDelete: SetNull)
  members             OrganizationMember[]
  subscription        Subscription?
  connectedAccounts   ConnectedAccount[]
  googleAdsConnection GoogleAdsConnection?
  adAccounts          AdAccount[]
  reportPreference    ReportPreference?
  whatsappContact     WhatsAppContact?
  messageDeliveries   WhatsAppMessageDelivery[]
  dailyReports        DailyReport[]
  reportSnapshots     ReportSnapshot[]
  chatConversations   ChatConversation[]
  auditLogs           AuditLog[]
  scheduledJobs       ScheduledJob[]
  usageLogs           UsageLog[]

  @@index([status])
  @@index([ownerUserId])
  @@index([deletedAt])
}

model OrganizationMember {
  id             String         @id @default(cuid())
  organizationId String
  userId         String
  role           MembershipRole @default(OWNER)
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  organization   Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user           User           @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([organizationId, userId])
  @@index([userId])
}

model AuthAccount {
  id                String   @id @default(cuid())
  userId            String
  provider          String
  providerAccountId String
  refreshToken      String?
  accessToken       String?
  expiresAt         Int?
  tokenType         String?
  scope             String?
  idToken           String?
  sessionState      String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Subscription {
  id                   String             @id @default(cuid())
  organizationId       String             @unique
  provider             String             @default("stripe")
  planCode             PlanCode
  status               SubscriptionStatus @default(INCOMPLETE)
  stripeCustomerId     String?            @unique
  stripeSubscriptionId String?            @unique
  stripePriceId        String?
  currentPeriodStart   DateTime?
  currentPeriodEnd     DateTime?
  cancelAtPeriodEnd    Boolean            @default(false)
  canceledAt           DateTime?
  activatedAt          DateTime?
  pausedAt             DateTime?
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt

  organization         Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([status])
  @@index([planCode])
}

model ConnectedAccount {
  id                  String                   @id @default(cuid())
  organizationId      String
  provider            ConnectedAccountProvider
  status              ConnectionStatus         @default(PENDING)
  externalAccountId   String?
  externalAccountName String?
  lastValidatedAt     DateTime?
  lastErrorCode       String?
  lastErrorMessage    String?
  disconnectedAt      DateTime?
  createdAt           DateTime                 @default(now())
  updatedAt           DateTime                 @updatedAt

  organization        Organization             @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, provider])
  @@index([organizationId, provider, status])
}

model GoogleAdsConnection {
  id                    String              @id @default(cuid())
  organizationId        String              @unique
  connectedAccountId    String?             @unique
  googleUserEmail       String?
  oauthScope            String?
  accessTokenEncrypted  String?
  refreshTokenEncrypted String?
  tokenExpiresAt        DateTime?
  developerTokenRef     String?
  managerCustomerId     String?
  selectedCustomerId    String?
  selectedAccountName   String?
  status                ConnectionStatus    @default(PENDING)
  syncStatus            GoogleAdsSyncStatus @default(IDLE)
  lastSyncedAt          DateTime?
  lastRefreshAt         DateTime?
  lastErrorCode         String?
  lastErrorMessage      String?
  disconnectedAt        DateTime?
  createdAt             DateTime            @default(now())
  updatedAt             DateTime            @updatedAt

  organization          Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([status])
  @@index([selectedCustomerId])
  @@index([syncStatus])
}

model AdAccount {
  id                String                   @id @default(cuid())
  organizationId    String
  provider          ConnectedAccountProvider @default(GOOGLE_ADS)
  externalAccountId String
  name              String
  currencyCode      String?
  isPrimary         Boolean                  @default(false)
  isActive          Boolean                  @default(true)
  lastSeenAt        DateTime?
  createdAt         DateTime                 @default(now())
  updatedAt         DateTime                 @updatedAt

  organization      Organization             @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  reportSnapshots   ReportSnapshot[]
  dailyReports      DailyReport[]

  @@unique([organizationId, provider, externalAccountId])
  @@index([organizationId, isPrimary])
}

model ReportPreference {
  id              String       @id @default(cuid())
  organizationId  String       @unique
  deliveryTime    String
  timezone        String
  locale          String       @default("es")
  reportFormat    ReportFormat @default(STANDARD)
  tone            String       @default("simple")
  currency        String       @default("USD")
  priorityMetrics String[]
  sendWeekends    Boolean      @default(true)
  isPaused        Boolean      @default(false)
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  organization    Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
}

model WhatsAppContact {
  id                 String               @id @default(cuid())
  organizationId     String               @unique
  provider           WhatsAppProvider     @default(MOCK)
  phoneNumberE164    String
  phoneNumberRaw     String?
  consentGivenAt     DateTime?
  consentIp          String?
  isVerified         Boolean              @default(false)
  verificationStatus ConnectionStatus     @default(PENDING)
  lastMessageSentAt  DateTime?
  lastErrorMessage   String?
  createdAt          DateTime             @default(now())
  updatedAt          DateTime             @updatedAt

  organization       Organization         @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  messageDeliveries  WhatsAppMessageDelivery[]

  @@index([phoneNumberE164])
}

model DailyReport {
  id                String          @id @default(cuid())
  organizationId    String
  adAccountId       String?
  reportDate        DateTime
  channel           ReportChannel   @default(WHATSAPP)
  format            ReportFormat
  locale            String          @default("es")
  status            ReportStatus    @default(PENDING)
  headline          String?
  summaryText       String
  structuredPayload Json
  llmPromptVersion  String?
  generationModel   String?
  generatedAt       DateTime?
  sentAt            DateTime?
  failedAt          DateTime?
  errorMessage      String?
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  organization      Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  adAccount         AdAccount?      @relation(fields: [adAccountId], references: [id], onDelete: SetNull)
  deliveries        WhatsAppMessageDelivery[]

  @@unique([organizationId, reportDate, channel])
  @@index([organizationId, reportDate])
  @@index([status])
}

model ReportSnapshot {
  id                String       @id @default(cuid())
  organizationId    String
  adAccountId       String?
  snapshotDate      DateTime
  campaignId        String?
  campaignName      String?
  impressions       BigInt?
  clicks            BigInt?
  ctr               Decimal?     @db.Decimal(10, 4)
  costMicros        BigInt?
  conversions       Decimal?     @db.Decimal(12, 4)
  costPerConversion Decimal?     @db.Decimal(12, 4)
  conversionRate    Decimal?     @db.Decimal(10, 4)
  currencyCode      String?
  rawMetrics        Json?
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt

  organization      Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  adAccount         AdAccount?   @relation(fields: [adAccountId], references: [id], onDelete: SetNull)

  @@unique([organizationId, snapshotDate, campaignId])
  @@index([organizationId, snapshotDate])
  @@index([organizationId, campaignName])
  @@index([adAccountId, snapshotDate])
}

model ChatConversation {
  id             String            @id @default(cuid())
  organizationId String
  userId         String
  title          String?
  source         ChatMessageSource @default(WEB)
  lastMessageAt  DateTime?
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  organization   Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user           User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages       ChatMessage[]

  @@index([organizationId, lastMessageAt])
  @@index([userId])
}

model ChatMessage {
  id              String            @id @default(cuid())
  conversationId  String
  role            ChatMessageRole
  source          ChatMessageSource @default(WEB)
  content         String
  groundedContext Json?
  model           String?
  promptVersion   String?
  createdAt       DateTime          @default(now())

  conversation    ChatConversation  @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
}

model WhatsAppMessageDelivery {
  id                String                 @id @default(cuid())
  organizationId    String
  whatsappContactId String
  dailyReportId     String?
  direction         String                 @default("OUTBOUND")
  provider          WhatsAppProvider
  providerMessageId String?
  messageBody       String
  deliveryStatus    WhatsAppDeliveryStatus @default(PENDING)
  attemptCount      Int                    @default(0)
  lastAttemptAt     DateTime?
  deliveredAt       DateTime?
  failedAt          DateTime?
  errorCode         String?
  errorMessage      String?
  createdAt         DateTime               @default(now())
  updatedAt         DateTime               @updatedAt

  organization      Organization           @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  whatsappContact   WhatsAppContact        @relation(fields: [whatsappContactId], references: [id], onDelete: Cascade)
  dailyReport       DailyReport?           @relation(fields: [dailyReportId], references: [id], onDelete: SetNull)

  @@index([organizationId, deliveryStatus])
  @@index([providerMessageId])
}

model ScheduledJob {
  id             String        @id @default(cuid())
  organizationId String?
  jobType        JobType
  status         JobStatus     @default(PENDING)
  dedupeKey      String?       @unique
  scheduledFor   DateTime
  startedAt      DateTime?
  finishedAt     DateTime?
  attemptCount   Int           @default(0)
  maxAttempts    Int           @default(3)
  payload        Json?
  result         Json?
  errorMessage   String?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([status, scheduledFor])
  @@index([organizationId, jobType])
}

model UsageLog {
  id             String       @id @default(cuid())
  organizationId String
  eventKey       String
  value          Int?
  metadata       Json?
  createdAt      DateTime     @default(now())

  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId, eventKey, createdAt])
}

model AuditLog {
  id             String         @id @default(cuid())
  organizationId String?
  userId         String?
  eventType      AuditEventType
  entityType     String?
  entityId       String?
  message        String?
  metadata       Json?
  createdAt      DateTime       @default(now())

  organization   Organization?  @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  user           User?          @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([organizationId, createdAt])
  @@index([userId, createdAt])
  @@index([eventType, createdAt])
}
